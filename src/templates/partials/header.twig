<nav class="main-nav">
    <div class="container">
        <!-- Logo -->
        <a href="index.html" class="logo">
            <div class="site-header__logo">
                <img src="/src/assets/images/logo.svg" alt="Binabox Logo" class="site-header__logo-img">
            </div>
         </a>

        <!-- Navigation Menu -->
        <ul class="nav-menu">
            {% for item in common.site.menu %}
                <li class="nav-item {% if item.active %}active{% endif %}">
                    <a href="{{ item.url }}" class="nav-link">{{ item.label }}</a>
                </li>
            {% endfor %}
        </ul>

        <!-- Search Form -->
        <form action="/search" method="GET" class="header-search">
            <input type="search" name="q" class="page-header__search" placeholder="Search..." required>
        </form>

        <!-- Action Buttons -->
        <a href="{{ common.site.discordUrl }}" class="btn page-header__btn--discord">Discord</a>
        <button class="page-header__btn page-header__btn--login" type="button">Log In</button>
    </div>
</nav>
