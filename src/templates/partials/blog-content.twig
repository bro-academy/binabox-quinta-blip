<section class="blog-content">
  <h2 class="blog-content__title">{{ content.title }}</h2>

  {% for paragraph in content.paragraphs %}
    <p class="blog-content__text">{{ paragraph }}</p>
  {% endfor %}

  <h3 class="blog-content__subtitle">{{ content.subtitle }}</h3>

  {% for generator in content.generators %}
    <p class="blog-content__text">
      {{ generator.text }}
      {% if generator.link %}
        <a href="{{ generator.link.href }}" class="blog-content__link">{{ generator.link.text }}</a>
      {% endif %}
    </p>
  {% endfor %}

  <div class="blog-extras">
    <!-- Tags -->
    <div class="blog-extras__tags">
      <span class="blog-extras__tags-label">Tags:</span>
      {% for tag in content.tags %}
        <button class="blog-extras__tag">{{ tag }}</button>
      {% endfor %}
    </div>

    <!-- Share Links -->
    <div class="blog-extras__share">
      <h4 class="blog-extras__share-label">Share:</h4>
      {% for share in content.share_links %}
        <a href="{{ share.href }}" 
           class="blog-extras__share-link blog-extras__share-link--{{ share.platform | lower }}">
           {{ share.platform }}
        </a>
      {% endfor %}
    </div>
  </div>
</section>
