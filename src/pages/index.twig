{% extends "src/templates/layouts/base.twig" %}


{% block content %}

<!-- ============== BANNER ============== -->
<section class="banner">
    <h1 class="banner__title">{{ common.site.title }}: Explore NFT Collections</h1>
    <p class="banner__text">{{ page.banner_text }}</p>

    <div class="banner-section">
        {% for stat in page.banner_stats %}
            <div class="banner-section__item">
                <span class="banner-section__value">{{ stat.value }}</span>
                <p class="banner-section__text">{{ stat.text }}</p>
            </div>
        {% endfor %}
    </div>

    <div class="banner__actions">
        <button class="banner__button banner__button--primary">Connect Wallet</button>
        <button class="banner__button banner__button--disable">Whitelist now</button>
    </div>

    <img src="{{ page.banner_image }}" class="banner__image" alt="Banner Image">
</section>

<!-- ============== CATALOG ============== -->
<section class="catalog">
    <div class="catalog__header">
        <h2 class="catalog__title">Catalog</h2>
        <button class="catalog__button catalog__button--default">See All</button>
    </div>

    <ul class="catalog__list">
        {% for product in page.catalog_products %}
            <li class="catalog__item">
                <article class="catalog__product">
                    <img src="{{ product.image }}" class="catalog__image" alt="{{ product.title }}">
                    {% if product.badge %}
                        <span class="catalog__badge">{{ product.badge }}</span>
                    {% endif %}
                    <span class="catalog__value">{{ product.price }}</span>
                    <p class="catalog__title">{{ product.title }}</p>
                </article>
            </li>
        {% endfor %}
    </ul>
</section>

<!-- ============== BLOG ============== -->
<section class="blog">
    <h2 class="blog__title">Our Blog</h2>
    {% for post in page.blog_posts %}
        <article class="blog__post">
            <img src="{{ post.image }}" class="blog__image" alt="{{ post.title }}">
            <div class="blog__meta">
                <span class="blog__subtitle">{{ post.author }}</span> |
                <span class="blog__date">{{ post.date }}</span>
                {% if post.badge %} | <span class="blog__badge">{{ post.badge }}</span>{% endif %}
            </div>
            <h3 class="blog__title">{{ post.title }}</h3>
            <p class="blog__description">{{ post.description }}</p>
            <button class="blog__btn blog__btn--read-more">Read more</button>
        </article>
    {% endfor %}
</section>

<!-- ============== ABOUT ============== -->
<section class="about">
    <h2 class="about__title">About Us</h2>
    <p class="about__intro">{{ page.about_intro }}</p>
    <ol class="about__list">
        {% for item in page.about_items %}
            <li class="about__item">
                <h3 class="about__subtitle">{{ item.subtitle }}</h3>
                <p class="about__text">{{ item.text }}</p>
            </li>
        {% endfor %}
    </ol>
</section>

<!-- ============== TEAM ============== -->
<section class="team">
    <h2 class="team__title">Our Team</h2>
    {% for member in page.team_members %}
        <div class="team__card">
            <img src="{{ member.image }}" alt="{{ member.name }}" class="team__image">
            <h3 class="team__name">{{ member.name }}</h3>
            <p class="team__role">{{ member.role }}</p>
            <ul class="team__social">
                {% for social in member.social %}
                    <li class="team__social-item">
                        <a href="{{ social.link }}" class="team__social-link" target="_blank">{{ social.platform }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endfor %}
</section>

<!-- ============== FAQ ============== -->
<section class="faq">
    <h2 class="faq__title">FAQs</h2>
    {% for faq in page.faqs %}
        <details class="faq__item">
            <summary class="faq__question">{{ faq.question }}</summary>
            <p class="faq__answer">{{ faq.answer }}</p>
        </details>
    {% endfor %}
</section>

{% endblock %}
